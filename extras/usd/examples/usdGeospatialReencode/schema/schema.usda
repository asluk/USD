#usda 1.0
(
    """
    schema.usda -- SOURCE schema definition for the geospatial CRS prototype.

    CODELESS schema (skipCodeGeneration = true): usdGenSchema emits only
    generatedSchema.usda + plugInfo.json (no C++). USD loads the typed prim +
    applied API from those registry files, so crs:* properties authored with
    custom=False are TRUTHFULLY schema-defined (review fix #3a).

    Two schemas:
      * CoordinateReferenceSystem (concrete typed IsA) -- carries the WKT2 string.
      * CRSBindingAPI (single-apply API) -- crs:position + crs:binding, modelled
        on UsdShadeMaterialBindingAPI.

    AXIS-ORDER CONTRACT: crs:position is ALWAYS (x = longitude/easting,
    y = latitude/northing, z = height) -- east-north-up / always_xy -- regardless
    of the bound CRS authority's declared axis order. See docs/axis-order.md.

    Regenerate registry files with:
        usdGenSchema schema/schema.usda schema/resources -t <codegenTemplates>
    """
    subLayers = [
        @usd/schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName      = "usdGeospatialCRS"
        string libraryPath      = "."
        bool skipCodeGeneration = true
        bool useLiteralIdentifier = 1
    }
)
{
}

class CoordinateReferenceSystem "CoordinateReferenceSystem" (
    inherits = </Typed>
    doc = """A coordinate reference system. Carries an OGC WKT2 definition and
    optional EPSG / display-name identification. Pure data: declares a CRS, does
    not itself transform anything."""
    customData = {
        string className = "CoordinateReferenceSystem"
    }
)
{
    uniform token crs:wkt = "" (
        doc = "OGC WKT2_2019 definition of this CRS. Authoritative source of the CRS."
    )
    uniform int crs:epsg = 0 (
        doc = "Optional EPSG code. Informational; crs:wkt is authoritative if they disagree."
    )
    uniform string crs:displayName = "" (
        doc = "Human-readable name for tools/UI."
    )
}

class "CRSBindingAPI" (
    inherits = </APISchemaBase>
    doc = """Applied to a prim to give it a geospatial position in a bound CRS,
    analogous to UsdShadeMaterialBindingAPI. The bound CRS is inherited by
    descendants that have no binding of their own (nearest-ancestor wins). The
    prim's own UsdGeomXformable stack is expected to remain identity in the
    CRS-neutral authored scene; a runtime resolver reprojects crs:position into
    the render/target CRS and composes ancestor Cartesian transforms on top."""
    customData = {
        string className = "CRSBindingAPI"
        token apiSchemaType = "singleApply"
    }
)
{
    double3 crs:position = (0, 0, 0) (
        doc = """Absolute position in the bound CRS, ALWAYS ordered
        (x = longitude/easting, y = latitude/northing, z = height) regardless of
        the bound CRS authority's declared axis order (east-north-up / always_xy)."""
    )
    rel crs:binding (
        doc = """Relationship to the CoordinateReferenceSystem prim defining the
        CRS that crs:position is expressed in. Inherited by descendants lacking
        their own binding (nearest-ancestor wins), like material binding."""
    )
}
