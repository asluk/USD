#usda 1.0
(
    """Approach B — Multi-apply applied schema with typed properties; each
    external system is a separate schema instance.

    Storage:  identifier data lives in typed schema properties.
    Schema:   four properties per instance (primaryId, revision, domain, label).
    Each application of the schema corresponds to one external system.

    Source of truth: PR #105 (identifier_separation_of_concerns, Approach B).
    """
    subLayers = [
        @../../../../pxr/usd/usd/schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName       = "sourceIdentifiersB"
        string libraryPath       = "."
        bool   skipCodeGeneration = true
    }
) {
}

class "SourceIdentifierAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType         = "multipleApply"
        token propertyNamespacePrefix = "sourceIdentifier"
    }
    doc = """Multi-apply schema; each instance carries one external system's
    identifier as typed properties.

    Apply: prim.ApplyAPI('SourceIdentifierAPI', 'windchill')
    Yields properties:
        sourceIdentifier:windchill:primaryId
        sourceIdentifier:windchill:revision
        sourceIdentifier:windchill:domain
        sourceIdentifier:windchill:label
    """
)
{
    string primaryId = "" (
        doc = "Primary identifier in the external system."
    )
    string revision = "" (
        doc = "Revision/version identifier. Empty string = unspecified."
    )
    token domain = "" (
        doc = """Reverse-DNS domain identifying the source system, e.g.
        com.ptc.windchill, org.buildingsmart.ifc, com.adobe.substance3d."""
    )
    string label = "" (
        doc = "Human-readable label for the identifier type, for UX display."
    )
}
