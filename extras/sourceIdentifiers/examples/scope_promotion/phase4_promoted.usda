#usda 1.0
(
    doc = """Phase 4: scope promoted to schema property.
    
    Same prims as Phase 2, but scope is now a typed token property on the
    schema instead of a string in the overflow dict. Benefits:
    
    1. Schema-validated: USD enforces the allowedTokens constraint
    2. GUI-visible: scope appears in property panels automatically
    3. Per-property composition: overriding scope doesn't touch other fields
    4. Queryable: tools can filter by scope without parsing assetInfo dicts
    
    Note: assetInfo overflow dicts STILL carry domain-specific metadata
    (batteryModel, displayNumber, frameId, etc.). Only scope moved out."""
)

# ── AAS DPP ───────────────────────────────────────────────────────────────

def Xform "BatteryPack_SN42" (
    prepend apiSchemas = ["SourceIdHybridAPI:dpp"]
    assetInfo = {
        dictionary sourceIds = {
            dictionary dpp = {
                # scope is GONE from here — promoted to schema property below
                string batteryModel = "LFP-280Ah-48V"
                string chemistry = "LFP"
                string manufacturingDate = "2025-03-15"
            }
        }
    }
)
{
    string sourceIdentifier:dpp:primaryId = "urn:idta:dpp:battery:SN42:2025"
    string sourceIdentifier:dpp:revision = "1.0"
    token sourceIdentifier:dpp:domain = "org.idta.dpp"
    string sourceIdentifier:dpp:label = "IEC 62474 Digital Battery Passport"
    # NEW: scope is now a schema property (was in overflow dict)
    token sourceIdentifier:dpp:scope = "instance"
}

