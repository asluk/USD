#usda 1.0
(
    """
    Approach C (Hybrid): Composition behavior test — BASE LAYER.
    
    Demonstrates how the hybrid composes: schema properties use per-property
    composition, while assetInfo metadata uses element-wise dict composition.
    """
    defaultPrim = "Chiller"
)

def Xform "Chiller" (
    kind = "component"
    assetInfo = {
        string name = "Carrier 30XA Chiller"
        string identifier = @assets/hvac/chiller_30xa.usd@
        string version = "2.1"
        dictionary sourceIds = {
            dictionary windchill = {
                string displayNumber = "CH-7500-A"
                string state = "In Work"
            }
            dictionary sap = {
                string materialType = "HAWA"
                string plant = "NYC1"
            }
        }
    }
    prepend apiSchemas = [
        "SourceIdHybridAPI:windchill",
        "SourceIdHybridAPI:sap",
        "SourceIdHybridAPI:ifc"
    ]
)
{
    string sourceIdentifier:windchill:primaryId = "VR:wt.part.WTPart:23639563"
    string sourceIdentifier:windchill:revision = "Rev.B"
    token sourceIdentifier:windchill:domain = "com.ptc.windchill"
    string sourceIdentifier:windchill:label = "Windchill Part OID"

    string sourceIdentifier:sap:primaryId = "000000000040012345"
    string sourceIdentifier:sap:revision = "01"
    token sourceIdentifier:sap:domain = "com.sap.s4hana"
    string sourceIdentifier:sap:label = "SAP Material Number"

    string sourceIdentifier:ifc:primaryId = "0VNpA$O4H5ywLJGHUdbGxK"
    token sourceIdentifier:ifc:domain = "org.buildingsmart.ifc"
    string sourceIdentifier:ifc:label = "IFC GlobalId"
}
